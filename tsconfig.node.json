{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "target": "ES2022",
        "lib": ["ES2023"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "noEmit": true,
        "types": ["node"]
    },
    "include": [
        "api",
        "scripts",
        "server",
        "shared",
        "drizzle.config.ts",
        "vite.config.ts",
        "vitest.config.ts"
    ]
}
