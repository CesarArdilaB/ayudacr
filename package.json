{
    "name": "ayudacr",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
        "dev:client": "vite",
        "dev:server": "tsx watch server/index.ts",
        "smoke:server": "tsx scripts/smoke-server.ts",
        "start": "tsx server/index.ts",
        "build": "tsc -b && vite build",
        "verify": "npm run lint && npm test && npm run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -b",
        "lint": "npm run format:check && npm run typecheck",
        "format": "biome check --write .",
        "format:check": "biome check .",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@expo-google-fonts/noto-sans": "^0.4.2",
        "@fontsource-variable/fraunces": "^5.3.0",
        "@fontsource-variable/manrope": "^5.3.0",
        "@pdf-lib/fontkit": "^1.1.1",
        "@vercel/functions": "^3.9.3",
        "better-auth": "^1.6.29",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "drizzle-orm": "^0.45.2",
        "express": "^5.2.1",
        "pdf-lib": "^1.17.1",
        "pg": "^8.16.3",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.8",
        "@electric-sql/pglite": "^0.5.5",
        "@napi-rs/canvas": "^1.0.6",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^24.10.1",
        "@types/pg": "^8.15.6",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.5",
        "concurrently": "^9.2.1",
        "drizzle-kit": "^0.31.10",
        "jsdom": "^27.2.0",
        "tsx": "^4.21.0",
        "typescript": "5.9.3",
        "vite": "^8.2.1",
        "vitest": "^4.1.0"
    }
}
